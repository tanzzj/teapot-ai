<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.teamer.teapot</groupId>
    <artifactId>teapot-ai-server</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>teapot-ai-server</name>
    <description>Teapot AI 平台后端（AgentScope Java 2.0.1），聚合模块；版本管理下沉到 teapot-ai-bom（SPEC §4）</description>

    <modules>
        <module>teapot-ai-bom</module>
        <module>teapot-ai-common</module>
        <module>teapot-ai-rbac</module>
        <module>teapot-ai-core</module>
        <module>teapot-ai-start</module>
        <module>teapot-ai-m0-check</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- 构建插件版本（业务依赖版本见 teapot-ai-bom） -->
        <spring-boot.version>3.5.16</spring-boot.version>
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 全部外部依赖版本由 bom 统一管理（SPEC §4.1） -->
            <dependency>
                <groupId>com.teamer.teapot</groupId>
                <artifactId>teapot-ai-bom</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${java.version}</release>
                        <encoding>UTF-8</encoding>
                        <!-- Spring 6.2+ 不再默认推断参数名（@RequestParam 等依赖），必须保留 -->
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
